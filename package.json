{
  "name": "scriptra",
  "productName": "Scriptra",
  "version": "0.2.0",
  "description": "观笺 - Windows 桌面电子书管理与阅读软件（Electron）",
  "author": "Scriptra Team",
  "license": "MIT",
  "main": "out/main/main.js",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs && electron . --dev",
    "start": "node build.mjs && electron .",
    "typecheck": "tsc --noEmit",
    "build:win": "node build.mjs && electron-builder --win",
    "build:win:portable": "node build.mjs && electron-builder --win portable"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.1",
    "jszip": "^3.10.1",
    "pdfjs-dist": "3.11.174"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0"
  },
  "build": {
    "appId": "com.scriptra.desktop",
    "productName": "Scriptra",
    "copyright": "Copyright © 2026 Scriptra (观笺)",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "${productName}-${version}-win-${arch}.${ext}",
      "fileAssociations": [
        {
          "ext": "epub",
          "name": "EPUB 电子书",
          "description": "用 观笺 Scriptra 打开 EPUB 电子书"
        },
        {
          "ext": "pdf",
          "name": "PDF 文档",
          "description": "用 观笺 Scriptra 打开 PDF 文档"
        },
        {
          "ext": "mobi",
          "name": "MOBI 电子书",
          "description": "用 观笺 Scriptra 打开 MOBI 电子书"
        },
        {
          "ext": "azw",
          "name": "AZW 电子书",
          "description": "用 观笺 Scriptra 打开 AZW 电子书"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "观笺 Scriptra",
      "uninstallDisplayName": "观笺 Scriptra",
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ]
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    }
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
